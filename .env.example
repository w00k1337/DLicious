# Database
# For better performance with bulk imports, consider adding connection pool settings to DATABASE_URL:
# postgresql://user:pass@host/db?connection_limit=20&pool_timeout=30
DATABASE_URL=
DIRECT_URL=

# Logging
LOG_LEVEL=info

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Queue Configuration (Optional - Redis Connection Management)
# QUEUE_WORKER_CONCURRENCY=5         # Number of concurrent jobs per worker (1-50, default: 1)

# Stash
STASH_BASE_URL=
STASH_API_KEY=

# StashDB
STASHDB_API_KEY=

# ThePornDB
THEPORNDB_API_KEY=