}

model Performer {
  id                String    @id @default(cuid())
  stashId           Int       @unique
  name              String
  aliases           String[]  @default([])
  imageUrl          String
  country           Country?
  birthdate         DateTime?
  cupSize           CupSize?
  bandSize          Int?
  hasNaturalBreasts Boolean?
  isFavorite        Boolean   @default(false)
  isMonitored       Boolean   @default(false)
  syncedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
