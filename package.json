{
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10.11.0"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "next dev --experimental-https",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
